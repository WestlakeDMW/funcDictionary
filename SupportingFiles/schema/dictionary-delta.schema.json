{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funcdictionary.local/schema/dictionary-delta-1.0.json",
  "title": "funcDictionary Dictionary Delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delta_id", "project_id", "base_revision", "target_revision", "created_at", "changed_fields", "definitions_created", "definitions_evolved", "fuzzy_terms_added", "relations_changed", "references_changed", "snapshots_changed", "proposals", "change_requests", "conflict_records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "delta_id": { "type": "string", "pattern": "^delta_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
    "base_revision": { "type": "integer", "minimum": 0 },
    "target_revision": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "changed_fields": { "type": "array", "items": { "type": "string" } },
    "definitions_created": { "type": "array", "items": { "$ref": "#/$defs/definition" } },
    "definitions_evolved": { "type": "array", "items": { "$ref": "#/$defs/definition_evolution" } },
    "fuzzy_terms_added": { "type": "array", "items": { "$ref": "#/$defs/fuzzy_term_change" } },
    "relations_changed": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "relations_removed": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "references_changed": { "type": "array", "items": { "$ref": "#/$defs/reference_change" } },
    "snapshots_changed": { "type": "array", "items": { "$ref": "#/$defs/snapshot_change" } },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "change_requests": { "type": "array", "items": { "$ref": "#/$defs/change_request" } },
    "conflict_records": { "type": "array", "items": { "$ref": "#/$defs/conflict_record" } }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "schema_version", "identity", "function", "code_locator", "visual_locator", "functional_locator", "fuzzy_terms", "relations", "references", "snapshots", "implementation_history", "review_status", "active_context", "lineage", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "project_id": { "type": "string" },
        "schema_version": { "const": "1.0" },
        "identity": { "type": "object" },
        "function": { "type": "object" },
        "code_locator": { "type": "object" },
        "visual_locator": { "type": "object" },
        "functional_locator": { "type": "object" },
        "fuzzy_terms": { "type": "array" },
        "relations": { "type": "array" },
        "references": { "type": "array" },
        "snapshots": { "type": "array" },
        "implementation_history": { "type": "array" },
        "human_priority": { "type": ["object", "null"] },
        "review_status": { "type": "string" },
        "lifecycle": { "type": ["object", "null"] },
        "change_heat": { "type": ["object", "null"] },
        "active_context": { "type": "boolean" },
        "lineage": { "type": "array" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "definition_evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "change_type", "changes", "code_impact", "semantic_impact", "milestone"],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "change_type": { "type": "string" },
        "changes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" }
                }
              }
            ]
          }
        },
        "code_impact": { "type": "number", "minimum": 0, "maximum": 1 },
        "semantic_impact": { "type": "number", "minimum": 0, "maximum": 1 },
        "milestone": { "type": "boolean" }
      }
    },
    "fuzzy_term_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "term"],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "term": { "type": "object" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "type": { "const": "calls" } }, "required": ["type"] },
        "then": { "properties": { "metadata": {
          "required": ["file", "line", "evidence"],
          "properties": {
            "file": { "type": "string", "minLength": 1, "not": { "pattern": "^/" } },
            "line": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "evidence": { "type": "string", "minLength": 1 }
          }
        } } }
      }],
      "required": ["id", "type", "source_definition_id", "target_definition_id", "metadata"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["contains", "calls", "uses", "depends_on", "triggers", "displays", "owns", "produces", "reads", "writes"] },
        "source_definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "target_definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "metadata": { "type": "object" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "reference_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "reference"],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "width", "height", "size_bytes", "perceptual_hash", "revision", "milestone"],
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string", "pattern": "^snapshots/[^/]+\\.jpg$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "perceptual_hash": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "milestone": { "type": "boolean" }
      }
    },
    "snapshot_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "snapshot"],
      "properties": {
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "action", "definition_ids", "status", "summary", "payload", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "project_id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
        "action": { "enum": ["split", "merge", "deprecated", "identity_change", "cluster"] },
        "definition_ids": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["pending", "approved", "adjusted", "rejected"] },
        "summary": { "type": "string" },
        "payload": { "type": "object", "additionalProperties": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "change_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "definition_id", "requested_change", "reason", "risk", "affected_definition_ids", "status", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "project_id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "requested_change": { "type": "object", "required": ["type", "summary"], "properties": { "type": { "type": "string" }, "summary": { "type": "string" } }, "additionalProperties": false },
        "reason": { "type": "string" },
        "risk": { "type": "string" },
        "affected_definition_ids": { "type": "array", "items": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" } },
        "proposed_values": { "type": "object", "additionalProperties": { "type": "string" } },
        "status": { "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "conflict_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_id", "definition_id", "field", "base_revision", "local_revision", "remote_revision", "local_value", "remote_value", "status", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "project_id": { "type": "string", "pattern": "^project_[a-zA-Z0-9_-]+$" },
        "definition_id": { "type": "string", "pattern": "^def_[a-zA-Z0-9_-]+$" },
        "field": { "type": "string" },
        "base_revision": { "type": "integer", "minimum": 0 },
        "local_revision": { "type": "integer", "minimum": 0 },
        "remote_revision": { "type": "integer", "minimum": 0 },
        "local_value": { "type": "string" },
        "remote_value": { "type": "string" },
        "status": { "enum": ["needs_review", "resolved"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
